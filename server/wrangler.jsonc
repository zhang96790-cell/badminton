{
  // Badminton Games online rooms: one Durable Object per room code, relaying the two players' messages.
  "name": "badminton-rooms",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "Room" },
      { "name": "QUEUE", "class_name": "Matchmaker" },
      { "name": "PRESENCE", "class_name": "Presence" }
    ]
  },
  // Free plan: Durable Objects must use the SQLite storage backend.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Room"] },
    { "tag": "v2", "new_sqlite_classes": ["Matchmaker"] },
    { "tag": "v3", "new_sqlite_classes": ["Presence"] }
  ],
  // Public values (the secret key is a Cloudflare secret: `wrangler secret put SUPABASE_SECRET`).
  "vars": {
    "SUPABASE_URL": "https://xyadhxnoqdanzbppgxni.supabase.co",
    "SUPABASE_PUBLISHABLE": "sb_publishable_Js004F487ToqbD1Cz6t1QQ_ZqpcIyjl"
  }
}
